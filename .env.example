# ─────────────────────────────────────────────────────────────
# Evalia — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Required — Google Gemini API key for the AI agents
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — PostgreSQL connection string.
# When set, Evalia uses PostgreSQL. When omitted, falls back to local SQLite.
#
# Local Docker (docker compose up -d):
#   DATABASE_URL=postgresql://evalia:evalia@localhost:5432/evalia
#
# Neon (free tier):
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase:
#   DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# Render Postgres:
#   DATABASE_URL=postgresql://user:pass@dpg-xxx.render.com/evalia
#
# DATABASE_URL=

# Optional — CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
