# ─────────────────────────────────────────────────────────────
# Evalia — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Required for the default Gemini provider — API key for backend AND worker
# processes. Set AGENT_BASE_URL instead when using an OpenAI-compatible endpoint.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional provider override. Without AGENT_BASE_URL the default model is
# gemini/gemini-2.5-flash and GEMINI_API_KEY is used. If a custom endpoint is
# selected, set a model name supported by that endpoint and ensure both the
# API and worker containers can reach it (do not use 127.0.0.1 across containers).
# AGENT_MODEL=
# AGENT_BASE_URL=
# AGENT_API_KEY=

# Optional — PostgreSQL connection string.
# When set, Evalia uses PostgreSQL. When omitted, falls back to local SQLite.
#
# Local Docker (docker compose up -d):
#   DATABASE_URL=postgresql://evalia:evalia@localhost:5432/evalia
#
# Neon (free tier):
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase:
#   DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# Render Postgres:
#   DATABASE_URL=postgresql://user:pass@dpg-xxx.render.com/evalia
#
# DATABASE_URL=

# Optional — CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — candidate AI-interview notice/version and application URL.
# Increment the notice version when disclosure text changes.
# AI_INTERVIEW_NOTICE_VERSION=ai-interview-v1
# FRONTEND_BASE_URL=http://localhost:3000

# Optional — production TURN relay for human WebRTC interviews. Configure a
# coturn server with REST/HMAC authentication and the same server-side secret.
# The API returns 10-minute per-user/per-room credentials; never expose this
# shared secret through a NEXT_PUBLIC_* variable.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SHARED_SECRET=

# Optional — SMTP for candidate interview-ready notifications.
# The candidate application tracker remains available if SMTP is not configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Optional — Judge0-compatible sandbox for the prep code workspace.
# This public CE host is suitable for local development only; use a private
# deployment or authenticated provider for production workloads.
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_TOKEN=

# ─────────────────────────────────────────────────────────────
# Identity & access
# ─────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION — secret used to sign session tokens.
# The app refuses to start with APP_ENV=production unless this is set.
# In development, set a stable random local value if sessions should survive
# backend restarts. Never reuse a development value in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Optional — access token lifetime in hours (default 12)
# ACCESS_TOKEN_TTL_HOURS=12

# Optional — bcrypt cost factor (default 12).
# Higher is slower and more resistant to offline cracking. Do not lower this
# in production; the test suite overrides it to 4 purely for speed.
# BCRYPT_ROUNDS=12

# Optional — deployment environment marker. Set to "production" to enable
# extra startup warnings (SQLite fallback, missing keys) and to require JWT_SECRET.
# APP_ENV=development

# Optional — basic in-memory per-IP abuse protection (see backend/app/shared/rate_limit.py).
# Set RATE_LIMIT_REQUESTS=0 to disable entirely.
# RATE_LIMIT_WINDOW_SECONDS must be positive when rate limiting is enabled.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional — legacy credential alias for a local OpenAI-compatible proxy.
# COPILOT_PROXY_API_KEY=not-needed


