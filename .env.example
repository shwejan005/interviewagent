# ─────────────────────────────────────────────────────────────
# Evalia — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Required — Google Gemini API key for the AI agents
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — PostgreSQL connection string.
# When set, Evalia uses PostgreSQL. When omitted, falls back to local SQLite.
#
# Local Docker (docker compose up -d):
#   DATABASE_URL=postgresql://evalia:evalia@localhost:5432/evalia
#
# Neon (free tier):
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase:
#   DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# Render Postgres:
#   DATABASE_URL=postgresql://user:pass@dpg-xxx.render.com/evalia
#
# DATABASE_URL=

# Optional — CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — Judge0-compatible sandbox for the prep code workspace.
# This public CE host is suitable for local development only; use a private
# deployment or authenticated provider for production workloads.
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_TOKEN=

# ─────────────────────────────────────────────────────────────
# Identity & access
# ─────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION — secret used to sign session tokens.
# The app refuses to start with APP_ENV=production unless this is set.
# In development, set a stable random local value if sessions should survive
# backend restarts. Never reuse a development value in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Optional — access token lifetime in hours (default 12)
# ACCESS_TOKEN_TTL_HOURS=12

# Optional — bcrypt cost factor (default 12).
# Higher is slower and more resistant to offline cracking. Do not lower this
# in production; the test suite overrides it to 4 purely for speed.
# BCRYPT_ROUNDS=12

# Optional — deployment environment marker. Set to "production" to enable
# extra startup warnings (SQLite fallback, missing keys) and to require JWT_SECRET.
# APP_ENV=development

# Optional — basic in-memory per-IP abuse protection (see backend/rate_limit.py).
# Set RATE_LIMIT_REQUESTS=0 to disable entirely.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional — only used if backend/agents.py is pointed at a local
# OpenAI-compatible proxy instead of Gemini (see docs/ARCHITECTURE.md).
# COPILOT_PROXY_API_KEY=not-needed


